# ---------------------------
# EMR Serverless Deployment (.env.example)
# Copy this file to `.env` and adjust the values for your environment.
# All scripts and the Makefile auto-load `.env` from the repo root.
# ---------------------------

# AWS region where your EMR Serverless app lives
REGION=eu-west-2

# S3 bucket for storing job zips and logs (must exist in the same REGION)
# Scripts derive paths as:
#   Code: s3://$S3_BUCKET/jobs/$APP_NAME/
#   Logs: s3://$S3_BUCKET/logs/$APP_NAME/
S3_BUCKET=your-artifacts-bucket

# Optional: EMR Serverless Application ID
# Leave this unset if you want the scripts to create the application for you.
# When created via `make create`, the new application ID is written to `.emr_app_id`.
# If you already have an app (e.g., created in AWS Console) and want to reuse it,
# you can put its ID here to skip the create step.
# EMR_APP_ID=00fulej7qh7jt90t

# IAM Role ARN that EMR Serverless will assume for running jobs
# NOTE: This must be an **Execution Role ARN**, not the Application ARN.
EMR_EXECUTION_ROLE=arn:aws:iam::<your-aws-account-id>:role/YourEmrServerlessExecutionRole

# Optional — environment name used for tagging/paths (e.g., dev, staging, prod)
DEPLOY_ENV=dev

# Optional — free-text message that can be embedded in a manifest (if enabled later)
DEPLOYMENT_NOTE="First deployment to dev environment"

# ---------------------------
# Application / Image
# ---------------------------

# Application name for EMR Serverless
APP_NAME=emr-spark-uv

# EMR release label (ensure it matches your base image tag).
# emr-7.13.0+ is required for Spark Connect interactive sessions.
RELEASE_LABEL=emr-7.13.0

# Your custom Docker image in ECR including tag.
# Example: <your-aws-account-id>.dkr.ecr.eu-west-2.amazonaws.com/emr-pyspark:7.13.0
IMAGE_URI=<your-aws-account-id>.dkr.ecr.eu-west-2.amazonaws.com/emr-pyspark:7.13.0

# ---------------------------
# Optional logging overrides
# ---------------------------
# By default, logs go to s3://$S3_BUCKET/logs/$APP_NAME/
# You can override with:
# S3_LOG_PREFIX=s3://some-other-bucket/custom/logs/path/

# ---------------------------
# Spark Connect (optional, interactive PySpark from your laptop)
# ---------------------------
# Requires emr-7.13.0+. Set this before `deploy-to-emr --create-app` so the
# application accepts Spark Connect sessions, then use the `spark-connect` CLI.
# See docs/spark_connect_guide.md. No VPC/bastion needed.
# SPARK_CONNECT_ENABLED=true

# ---------------------------
# EMR Studio (optional)
# ---------------------------
# Provision with: terraform apply -var enable_emr_studio=true
# Open the Studio at `terraform output EMR_STUDIO_URL`.
# Set this before `deploy-to-emr --create-app` so the application exposes
# interactive endpoints and can run notebooks from EMR Studio:
# EMR_STUDIO_ENABLED=true
